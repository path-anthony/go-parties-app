# Admin API base URL for Ask GO recommendations. Defaults to http://localhost:3001 if unset.
VITE_ADMIN_API_URL=http://localhost:3001

# Stripe publishable key (public by nature; the secret key never lives in this repo).
# Without it every payment screen says online payment is coming soon.
VITE_STRIPE_PUBLISHABLE_KEY=

# Google Maps browser key (Maps JavaScript API and Places API (New) enabled,
# restricted to this site's address; never a server key). Without it the who
# screen keeps the plain address field and sends delivery: null.
VITE_GOOGLE_MAPS_API_KEY=
# Optional map ID for a styled map; advanced markers need one. DEMO_MAP_ID is used when blank.
VITE_GOOGLE_MAPS_MAP_ID=
